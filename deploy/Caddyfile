# Wewnętrzny Caddy usterki: słucha tylko na 127.0.0.1:8081 (patrz compose), HTTPS robi Twój istniejący Caddy.
{
	auto_https off
	servers {
		# Zachowaj X-Forwarded-Proto/For z zewnętrznego Caddy (inaczej Django widzi http i zapętla przekierowanie HTTPS)
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip zstd

	request_body {
		max_size 60MB
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		root * /srv
		file_server
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
