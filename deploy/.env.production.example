# Skopiuj na VPS jako .env w katalogu głównym repozytorium i uzupełnij. NIE commituj tego pliku.
DOMAIN=usterka.axword.pl
# Wygeneruj: openssl rand -base64 48
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
AUTH_PASSWORD_LOGIN=1

# Stripe (opcjonalnie; bez kluczy zakup planów jest zablokowany)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Microsoft Entra / SharePoint (opcjonalnie, docs/05-konfiguracja-microsoft.md)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT=organizations

# Adres, na którym kontener web nasłuchuje na porcie 8081. 127.0.0.1 = tylko host; gdy Caddy jest w Dockerze, podaj adres mostu docker0 (zwykle 172.17.0.1)
WEB_BIND=127.0.0.1

# Poczta (reset hasła, potwierdzenie e-maila, zaproszenia). Bez EMAIL_HOST wiadomości trafiają tylko do logów kontenera.
# OVH (skrzynka założona w panelu Emails): host ssl0.ovh.net, port 465 (SSL), użytkownik = pełny adres skrzynki
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Usterki na planie <noreply@axword.pl>
