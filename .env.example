# --- Django ---
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ustaw unikalny DJANGO_SECRET_KEY przed DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
# Domyślnie application/sqlite3.db. Produkcja / docker compose:
# DATABASE_URL=postgres://usterka:usterka@localhost:5432/usterka
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logowanie ---
# 1 = logowanie samym e-mailem (tylko lokalnie). Na produkcji 0.
AUTH_DEV_LOGIN=1

# --- Microsoft Entra ID + SharePoint (docs/05-konfiguracja-microsoft.md) ---
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# organizations = wiele firm (SaaS); ID dzierżawy = tylko jedna firma
ENTRA_TENANT=organizations
# Domyślnie api://<ENTRA_CLIENT_ID>
ENTRA_API_AUDIENCE=
ENTRA_ALLOW_ORG_SIGNUP=1

# --- Logowanie e-mailem i hasłem (własne konta) ---
AUTH_PASSWORD_LOGIN=1

# --- Subskrypcje Stripe (docs/06-subskrypcje-stripe.md). Puste + DJANGO_DEBUG=true = tryb demo bez płatności ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Adres frontendu do powrotu z płatności (domyślnie pierwszy z FRONTEND_ORIGINS)
FRONTEND_URL=
